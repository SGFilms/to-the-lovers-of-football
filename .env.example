# Скопируйте в .env и заполните. Файл .env в git не попадает.
# В Amvera те же значения задаются во вкладке «Переменные» (токены и пароли — секретами).

# Токен бота из @BotFather. Для компьютера — токен тестового бота, для сервера — боевого.
BOT_TOKEN=

# Ваш Telegram ID (можно несколько через запятую). Узнать: напишите @userinfobot.
ADMIN_IDS=

# Файл базы SQLite. Менять не нужно: /data — постоянное хранилище в Amvera и том в docker compose.
# DATABASE_PATH=/data/lflbot.db

# Домен бота без https://: в Amvera — домен проекта со вкладки «Домены», на своём сервере —
# домен, направленный на IP сервера. На своём компьютере оставьте пустым.
DOMAIN=

# ЮKassa: shopId и секретный ключ из раздела «Интеграция» → «Ключи API».
# Пока пусто, бот работает без оплаты. Для проверок — ключи тестового магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Прокси только для запросов к Telegram, если сервер не достаёт до api.telegram.org
# (README, «Если сервер не достаёт до Telegram»). Пусто — напрямую. В Amvera (регион Москва)
# не нужен: там свой прокси до Telegram.
# Пример: socks5://логин:пароль@хост:порт
TELEGRAM_PROXY=

# Подписка: цена в рублях и срок в днях.
SUBSCRIPTION_PRICE=1.00
SUBSCRIPTION_DAYS=30

# Исполнитель в оферте: ФИО, ИНН самозанятого и email для обращений.
# Пока пусто, в оферте стоит «не указано». До запуска с боевым магазином заполнить обязательно.
SELLER_NAME=
SELLER_INN=
SELLER_EMAIL=

# Как часто (в секундах) заранее обновлять расписание одной избранной команды подписчиков.
# 0 — не обновлять заранее.
LFL_WARMUP_INTERVAL=60

# Резервная копия базы каждый день в это время (пусто — только командой /backup).
BACKUP_TIME=04:00
# Присылать копию администраторам в Telegram.
BACKUP_TELEGRAM=true
# Пароль шифрования копий. Пусто — без шифрования. Храните его отдельно от сервера.
BACKUP_PASSWORD=
# Почта для копий (пусто — не отправлять) и SMTP вашего ящика, подробнее в README.
BACKUP_EMAIL=
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

DISPLAY_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
