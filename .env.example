# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота из @BotFather. Для компьютера — токен тестового бота, для сервера — боевого.
BOT_TOKEN=

# Ваш Telegram ID (можно несколько через запятую). Узнать: напишите @userinfobot.
ADMIN_IDS=

# База данных. Пароль придумайте длинный, из латинских букв и цифр.
POSTGRES_USER=lflbot
POSTGRES_PASSWORD=
POSTGRES_DB=lflbot

# Только для сервера: домен, направленный на IP сервера.
DOMAIN=

# ЮKassa: shopId и секретный ключ из раздела «Интеграция» → «Ключи API».
# Пока пусто, бот работает без оплаты. Для проверок — ключи тестового магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Подписка: цена в рублях и срок в днях.
SUBSCRIPTION_PRICE=1.00
SUBSCRIPTION_DAYS=30

# Исполнитель в оферте: ФИО, ИНН самозанятого и email для обращений.
# Пока пусто, в оферте стоит «не указано». До запуска с боевым магазином заполнить обязательно.
SELLER_NAME=
SELLER_INN=
SELLER_EMAIL=

DISPLAY_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
